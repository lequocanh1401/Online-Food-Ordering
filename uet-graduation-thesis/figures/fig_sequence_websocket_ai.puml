@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam DefaultFontSize 12

actor "Quản trị viên\n(Owner / Super Admin)" as adminActor
participant "Client React\n(AiCopilot / OrderListener)" as clientUI
participant "Order / Food / Review\nController" as coreCtrl
participant "OrderWebSocketHandler\n(/ws/orders)" as wsHandler
participant "AiCopilotServiceImpl\n(Dual-Persona & Agentic)" as aiSvc
participant "Google Gemini 2.5 Flash\n(hoặc Heuristic DSS)" as gemini
database "MySQL Database" as db

== 1. Phát sóng Đơn hàng Thời gian thực & Trừ kho ACID ==
coreCtrl -> coreCtrl : createOrder() -> depleteStockForOrder()
coreCtrl -> wsHandler : broadcastToRestaurant(restaurantId, OrderNotificationDTO)
activate wsHandler
wsHandler -> clientUI : TextMessage JSON ("NEW_ORDER", orderId, totalAmount)
clientUI -> clientUI : playOrderChime() (Web Audio API: E5 -> G#5 -> B5) & Reload Orders
deactivate wsHandler

== 2. Tham vấn Chiến lược Đa vai trò & Tác tử AI Hành động (Agentic AI) ==
adminActor -> clientUI : Truy cập AI Copilot & Gửi truy vấn (VD: Cảnh báo kho / Kiểm duyệt)
clientUI -> aiSvc : POST /api/admin/ai/copilot/chat (restaurantId hoặc null=SuperAdmin)
activate aiSvc

aiSvc -> db : collectRestaurantMetrics(restaurantId)\n(GMV, CSAT, Top món, Tồn kho, Đánh giá)
aiSvc -> gemini : callGeminiApi(gemini-2.5-flash, Context Prompt)
alt Gemini 2.5 Flash phản hồi HTTP 200
    gemini --> aiSvc : Phân tích Markdown chuyên sâu
else Quá hạn / Mất kết nối / Chưa cấu hình Key
    aiSvc -> aiSvc : generateHeuristicBusinessInsight() (Fallback DSS < 5ms)
end

aiSvc -> aiSvc : determineAgentAction()\n-> Sinh payload LOCK_FOOD_AVAILABILITY (Owner)\nhoặc MODERATE_REVIEW (Super Admin)
aiSvc --> clientUI : HTTP 200 OK (AiChatResponse + agentAction)
deactivate aiSvc

clientUI --> adminActor : Hiển thị Báo cáo Markdown + Thẻ Nút Tác tử AI 1-Click

opt Người dùng nhấn nút thực thi Tác tử AI 1-Click
    adminActor -> clientUI : Click nút Tác tử AI trên thẻ Đề xuất
    alt Owner: Tạm khóa món cạn kho
        clientUI -> coreCtrl : PUT /api/admin/food/{foodId}
        coreCtrl -> db : Cập nhật available = false (Đồng bộ Menu khách)
    else Super Admin: Gỡ đánh giá vi phạm
        clientUI -> coreCtrl : DELETE /api/reviews/{reviewId}
        coreCtrl -> db : Xóa Review vi phạm & Phục hồi CSAT
    end
    coreCtrl --> clientUI : HTTP 200 OK -> Hiển thị xác nhận đã thực thi
end
@enduml
