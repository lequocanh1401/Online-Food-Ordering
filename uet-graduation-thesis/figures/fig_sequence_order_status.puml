@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam DefaultFontSize 12

actor "Chủ nhà hàng\n(Restaurant Owner)" as owner
participant "Admin Portal\n(OrderTable.jsx)" as adminUI
participant "AdminOrderController\n(/api/admin/orders)" as adminOrderCtrl
participant "OrderServiceImpl\n(State Guard)" as orderSvc
participant "IngredientsService" as ingSvc
participant "OrderWebSocketHandler\n(/ws/orders)" as wsHandler
database "MySQL Database" as db

== Xem Danh sách Đơn hàng Mới nhất Lên đầu ==
owner -> adminUI : Mở trang "Quản lý Đơn hàng" (/admin/restaurant/orders)
adminUI -> adminOrderCtrl : GET /api/admin/order/restaurant/{restaurantId}
activate adminOrderCtrl
adminOrderCtrl -> orderSvc : getRestaurantsOrder(restaurantId, orderStatus)
orderSvc -> db : SELECT * FROM orders WHERE restaurant_id = ?\nORDER BY createdAt DESC, id DESC
db --> orderSvc : List<Order> (Sắp xếp mới nhất lên đầu)
orderSvc --> adminOrderCtrl : List<Order>
adminOrderCtrl --> adminUI : HTTP 200 OK
deactivate adminOrderCtrl
adminUI --> owner : Hiển thị bảng đơn hàng kèm nhãn STRIPE / COD

== Kiểm soát Máy Trạng thái & Cập nhật Giao vận ==
owner -> adminUI : Chọn đơn & Chuyển trạng thái (PAID / OUT_FOR_DELIVERY / COMPLETED / CANCELLED)
adminUI -> adminOrderCtrl : PUT /api/admin/order/{orderId}/{orderStatus}
activate adminOrderCtrl
adminOrderCtrl -> orderSvc : updateOrder(orderId, orderStatus)
activate orderSvc
orderSvc -> db : SELECT * FROM orders WHERE id = ?
db --> orderSvc : order

alt Vi phạm Terminal State (đã COMPLETED hoặc CANCELLED)
    orderSvc --> adminOrderCtrl : Exception("Đơn đã kết thúc, không thể đổi trạng thái!")
else Đơn STRIPE đang PENDING nhưng nhảy cóc sang Giao/Hoàn thành
    orderSvc --> adminOrderCtrl : Exception("Chờ khách thanh toán hoặc xác nhận PAID/CANCELLED!")
else Chuyển đổi trạng thái hợp lệ
    opt Chuyển sang CANCELLED
        orderSvc -> ingSvc : restoreStockForOrder(order)\n(Hoàn trả tồn kho & ghi AUTO_RESTORE)
    end
    orderSvc -> db : UPDATE orders SET orderStatus = ? WHERE id = ?
    orderSvc -> wsHandler : broadcastToRestaurant(STATUS_UPDATED)
    orderSvc --> adminOrderCtrl : updatedOrder
end
deactivate orderSvc
adminOrderCtrl --> adminUI : Phản hồi kết quả cập nhật
deactivate adminOrderCtrl
adminUI --> owner : Cập nhật Badge & Thông báo trạng thái tức thì
@enduml
